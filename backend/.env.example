# ==============================================================================
# CALDIM IntelliSolve AI — Backend Environment Configuration
# Copy this file to .env before starting the backend application:
#   Copy-Item .env.example .env
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (PostgreSQL Primary)
# Phase 2 connects directly to PostgreSQL using application credentials.
DB_NAME=caldim_intellisolve
DB_USER=caldim_user
DB_PASSWORD=your_actual_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# AI Provider Configuration (Phase 3)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30

# Future LLM Configuration (Local Ollama / Gemini)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b

