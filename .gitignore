# ==============================================================================
# CALDIM IntelliSolve AI — Root .gitignore
# ==============================================================================

# Environment variable files (NEVER commit secrets or credentials)
.env
.env.*
!.env.example
!.env.*.example

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django local database artifacts & media
*.sqlite3
*.sqlite3-journal
db.sqlite3
staticfiles/
media/
infrastructure/backups/
*.sql

# Node.js & Frontend dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlint-cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI & LLM runtime model caches (do not commit large weight files)
models/
*.gguf
*.bin
*.pt
*.safetensors
.ollama/

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Test coverage & logs
*.log
.coverage
htmlcov/
.pytest_cache/
